<UserControl x:Class="NmcScsLauncher.App.Views.TruckPowertrainSelection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="PowertrainOptionTemplate">
            <StackPanel Margin="4,5" ToolTip="{Binding DataPath}">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CurrentText}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" />
                <TextBlock Text="{Binding TechnicalInfo}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="{Binding ReasonText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="PowertrainOptionContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            <Setter Property="ToolTip" Value="{Binding ReasonText}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="OptionBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Margin="2">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="OptionBorder" Property="Opacity" Value="0.8" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Aktualisieren" Command="{Binding RefreshTruckPowertrainCommand}" Padding="10,5" Margin="8,0,0,0" />
            <TextBlock Text="Motor &amp; Getriebe" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{Binding TruckPowertrainStatus}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
        <TextBlock Text="{Binding TruckPowertrainContext}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,10" />
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding TruckPowertrainIsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Motor suchen" FontWeight="SemiBold" />
                <TextBox x:Name="EngineSearch" Text="{Binding TruckPowertrainEngineSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,6" ToolTip="Motor nach Name, Leistung oder Quelle suchen" />
                <ListBox x:Name="EngineOptions" ItemsSource="{Binding TruckPowertrainEngines}" SelectedItem="{Binding TruckPowertrainSelectedEngine}"
                         Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         ItemTemplate="{StaticResource PowertrainOptionTemplate}" ItemContainerStyle="{StaticResource PowertrainOptionContainer}"
                         Height="210" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="{Binding TruckPowertrainEngineCount}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Getriebe suchen" FontWeight="SemiBold" />
                <TextBox x:Name="TransmissionSearch" Text="{Binding TruckPowertrainTransmissionSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,6" ToolTip="Getriebe nach Name, Gängen oder Quelle suchen" />
                <ListBox x:Name="TransmissionOptions" ItemsSource="{Binding TruckPowertrainTransmissions}" SelectedItem="{Binding TruckPowertrainSelectedTransmission}"
                         Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         ItemTemplate="{StaticResource PowertrainOptionTemplate}" ItemContainerStyle="{StaticResource PowertrainOptionContainer}"
                         Height="210" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="{Binding TruckPowertrainTransmissionCount}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Gewählte Kombination" FontWeight="SemiBold" Margin="0,14,0,3" />
        <TextBlock Text="{Binding TruckPowertrainPairStatus}" TextWrapping="Wrap" Margin="0,5,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Style.Triggers><DataTrigger Binding="{Binding TruckPowertrainPairVerified}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Button x:Name="InstallPowertrain" Content="Motor &amp; Getriebe einbauen" Command="{Binding InstallTruckPowertrainCommand}"
                HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,8" />
        <TextBlock Text="Beide Spiele müssen beendet sein. Unvollständig geprüfte Kombinationen bleiben gesperrt."
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" />
        <Expander Header="Prüfhinweise" Margin="0,10,0,0">
            <TextBox Text="{Binding TruckPowertrainDiagnostics, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
        </Expander>
    </StackPanel>
</UserControl>
