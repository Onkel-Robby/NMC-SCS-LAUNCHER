<Application x:Class="NmcScsLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0F14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111821" />
        <SolidColorBrush x:Key="CardBrush" Color="#151E29" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F7FB" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#95A3B3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F81F7" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#33C36B" />
    </Application.Resources>
</Application>
