<Window x:Class="NmcScsLauncher.App.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMC SCS LAUNCHER – LicenseHub"
        Width="620" Height="550"
        MinWidth="540" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Icon="/NmcScsLauncher.App;component/Assets/nmc-scs-launcher.ico">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="/NmcScsLauncher.App;component/Assets/nmc-scs-launcher-logo.png" Width="175" Height="58" Stretch="Uniform" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="LicenseHub-Aktivierung" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Für diesen Build ist eine gültige LicenseHub-Lizenz erforderlich."
                           Margin="0,7,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,22,0,0"
                Background="#111A24"
                BorderBrush="#263342"
                BorderThickness="1"
                CornerRadius="9"
                Padding="14">
            <StackPanel>
                <TextBlock Text="Aktueller Status"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11" />
                <TextBlock x:Name="StatusTextBlock"
                           Margin="0,5,0,0"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,22,0,0">
            <TextBlock Text="Lizenzschlüssel" FontWeight="SemiBold" />
            <PasswordBox x:Name="LicenseKeyPasswordBox"
                         Margin="0,8,0,0"
                         Padding="10,8"
                         MaxLength="100"
                         PasswordChar="●" />
            <TextBlock Margin="0,7,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="Der Product-Key ist Bestandteil des bereitgestellten Builds. Hier wird nur dein Lizenzschlüssel benötigt. Nach erfolgreicher Aktivierung wird der Lizenzschlüssel im Windows Credential Manager gespeichert." />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <ProgressBar x:Name="ProgressBar"
                         Height="6"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
            <TextBlock x:Name="ResultTextBlock"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="/NmcScsLauncher.App;component/Assets/nmc-it-service-logo.png" Width="105" Height="35" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Später"
                        Width="105"
                        Margin="0,0,9,0"
                        IsCancel="True" />
                <Button x:Name="RetryButton"
                        Content="Status erneut prüfen"
                        Width="145"
                        Margin="0,0,9,0"
                        Click="Retry_OnClick" />
                <Button x:Name="ActivateButton"
                        Content="Lizenz aktivieren"
                        Width="135"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Activate_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
