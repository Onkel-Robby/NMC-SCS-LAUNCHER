<Window x:Class="NmcScsLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMC SCS LAUNCHER"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="24">
            <StackPanel>
                <TextBlock Text="NMC" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="SCS LAUNCHER" Margin="0,2,0,34" Foreground="{StaticResource SecondaryTextBrush}" />
                <Border Background="#17263A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <TextBlock Text="⌂  Startseite" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="🚛  ETS2" Margin="12,12" />
                <TextBlock Text="🚚  ATS" Margin="12,12" />
                <TextBlock Text="▦  Modsets" Margin="12,12" />
                <TextBlock Text="👤  Profile" Margin="12,12" />
                <TextBlock Text="💾  Backup" Margin="12,12" />
                <TextBlock Text="⚙  Einstellungen" Margin="12,12" />
                <TextBlock Text="ⓘ  Info" Margin="12,12" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="42,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Spiele erkennen" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Steam-Installationen werden automatisch erkannt. Manuelle Pfade bleiben möglich."
                           Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,30,0,24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="26" Background="{StaticResource CardBrush}" CornerRadius="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Euro Truck Simulator 2" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Ets2Status}" Margin="0,6,0,0" Foreground="#67D391" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Automatisch erkennen" Command="{Binding DetectEts2Command}" Padding="14,8" Margin="0,0,8,0" />
                                <Button Content="Ordner auswählen" Command="{Binding BrowseEts2Command}" Padding="14,8" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Installationspfad" Margin="0,20,0,4" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#151E29" CornerRadius="7" Padding="12">
                                <TextBlock Text="{Binding Ets2InstallPath}" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Padding="26" Background="{StaticResource CardBrush}" CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="American Truck Simulator" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AtsStatus}" Margin="0,6,0,0" Foreground="#67D391" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Automatisch erkennen" Command="{Binding DetectAtsCommand}" Padding="14,8" Margin="0,0,8,0" />
                                <Button Content="Ordner auswählen" Command="{Binding BrowseAtsCommand}" Padding="14,8" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Installationspfad" Margin="0,20,0,4" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#151E29" CornerRadius="7" Padding="12">
                                <TextBlock Text="{Binding AtsInstallPath}" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Margin="0,18,0,0" Padding="16,10" Background="#1A2633" CornerRadius="8">
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2">
                <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Text="NMC Network" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
