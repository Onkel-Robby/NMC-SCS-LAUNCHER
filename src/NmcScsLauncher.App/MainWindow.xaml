<Window x:Class="NmcScsLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NmcScsLauncher.App"
        Title="NMC SCS LAUNCHER"
        Width="1280" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Icon="/NmcScsLauncher.App;component/Assets/nmc-scs-launcher.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#1F2B39" BorderThickness="0,0,1,0">
            <Grid Margin="20,24,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Image Source="/NmcScsLauncher.App;component/Assets/nmc-scs-launcher-logo.png"
                           Width="198"
                           Height="66"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           SnapsToDevicePixels="True" />
                    <Border Margin="0,14,0,20" Height="1" Background="#263342" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         SelectedIndex="{Binding CurrentPageIndex, Mode=TwoWay}"
                         Style="{StaticResource NavigationListStyle}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}">
                    <ListBoxItem><TextBlock Text="⌂   Übersicht" /></ListBoxItem>
                    <ListBoxItem><TextBlock Text="🚛  Euro Truck Simulator 2" /></ListBoxItem>
                    <ListBoxItem><TextBlock Text="🚚  American Truck Simulator" /></ListBoxItem>
                    <ListBoxItem><TextBlock Text="▦   Modsets" /></ListBoxItem>
                    <ListBoxItem><TextBlock Text="☁   Workshop" /></ListBoxItem>
                    <ListBoxItem><TextBlock Text="💾  Save-Editor" /></ListBoxItem>
                    <ListBoxItem><TextBlock Text="⚙   Einstellungen" /></ListBoxItem>
                    <ListBoxItem><TextBlock Text="ⓘ   Info" /></ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="3">
                    <Border Background="#0E151E" BorderBrush="#263342" BorderThickness="1" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Ausgewählt" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding SelectedModsetName}" Margin="0,4,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedModsetGameText}" Margin="0,3,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl SelectedIndex="{Binding CurrentPageIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,30,38,28">
                            <TextBlock Text="Übersicht" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="Spiele, Modsets und der nächste Start auf einen Blick." Margin="0,7,0,24" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" />

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
                                    <StackPanel>
                                        <TextBlock Text="EURO TRUCK SIMULATOR 2" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Ets2Status}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding Ets2InstallPath}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,7,0,14" />
                                        <TextBlock Text="{Binding Ets2ModsetCountText}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
                                    <StackPanel>
                                        <TextBlock Text="AMERICAN TRUCK SIMULATOR" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AtsStatus}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding AtsInstallPath}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,7,0,14" />
                                        <TextBlock Text="{Binding AtsModsetCountText}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,26,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Zuletzt verwendete Modsets" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Wähle ein Setup aus und starte direkt." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                <Button Grid.Column="1" Content="▶  AUSGEWÄHLTES MODSET STARTEN" Command="{Binding LaunchSelectedModsetCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,9" VerticalAlignment="Center" />
                            </Grid>

                            <ListBox ItemsSource="{Binding DashboardModsets}" SelectedItem="{Binding SelectedModset}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CardListItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                                                <TextBlock Grid.Column="1" Text="{Binding Game}" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding ModFolderDisplayPath}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding LastStartedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Margin="0,24,0,0" Background="#111A24" BorderBrush="#263342" BorderThickness="1" CornerRadius="10" Padding="14">
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,30,38,28">
                            <TextBlock Text="Euro Truck Simulator 2" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="Installation prüfen und ETS2-Modsets verwalten." Margin="0,7,0,22" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Installationsstatus" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{Binding Ets2Status}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Ets2InstallPath}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Automatisch erkennen" Command="{Binding DetectEts2Command}" Margin="0,0,8,0"/><Button Content="Ordner auswählen" Command="{Binding BrowseEts2Command}"/></StackPanel></Grid>
                            </Border>
                            <Grid Margin="0,24,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ETS2-Modsets" FontSize="21" FontWeight="SemiBold"/><Button Grid.Column="1" Content="▶ STARTEN" Command="{Binding LaunchSelectedModsetCommand}" Style="{StaticResource PrimaryButtonStyle}"/></Grid>
                            <ListBox ItemsSource="{Binding Ets2Modsets}" SelectedItem="{Binding SelectedModset}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CardListItemStyle}">
                                <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ModFolderDisplayPath}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding LastStartedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,30,38,28">
                            <TextBlock Text="American Truck Simulator" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="Installation prüfen und ATS-Modsets verwalten." Margin="0,7,0,22" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Installationsstatus" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{Binding AtsStatus}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding AtsInstallPath}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Automatisch erkennen" Command="{Binding DetectAtsCommand}" Margin="0,0,8,0"/><Button Content="Ordner auswählen" Command="{Binding BrowseAtsCommand}"/></StackPanel></Grid>
                            </Border>
                            <Grid Margin="0,24,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ATS-Modsets" FontSize="21" FontWeight="SemiBold"/><Button Grid.Column="1" Content="▶ STARTEN" Command="{Binding LaunchSelectedModsetCommand}" Style="{StaticResource PrimaryButtonStyle}"/></Grid>
                            <ListBox ItemsSource="{Binding AtsModsets}" SelectedItem="{Binding SelectedModset}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CardListItemStyle}">
                                <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ModFolderDisplayPath}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding LastStartedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,30,38,28">
                            <TextBlock Text="Modsets" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="Getrennte Mod-Ordner erstellen, importieren, duplizieren und starten. Profile bleiben im normalen SCS-Dokumentenpfad." Margin="0,7,0,22" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" />
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ModsetCountText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="▶ STARTEN" Command="{Binding LaunchSelectedModsetCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,9,0"/><Button Content="+ Neu" Command="{Binding CreateModsetCommand}" Margin="0,0,7,0"/><Button Content="Importieren" Command="{Binding ImportModsetCommand}" Margin="0,0,7,0"/><Button Content="Bearbeiten" Command="{Binding EditModsetCommand}" Margin="0,0,7,0"/><Button Content="Duplizieren" Command="{Binding DuplicateSelectedModsetCommand}" Margin="0,0,7,0"/><Button Content="Mod-Ordner öffnen" Command="{Binding OpenModsetHomeCommand}" Margin="0,0,7,0"/><Button Content="Entfernen" Command="{Binding RemoveModsetCommand}" Style="{StaticResource DangerButtonStyle}"/></StackPanel></Grid>
                            <Border Margin="0,0,0,12" Padding="12" Background="#101720" BorderBrush="#263342" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Duplizierung" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding DuplicationProgress, StringFormat={}{0:F0}%}" Foreground="{StaticResource SecondaryTextBrush}"/></Grid>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding DuplicationProgress}" Height="7" Margin="0,8,0,7" />
                                    <TextBlock Text="{Binding DuplicationProgressText}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <local:ModsetBackupPanel />
                            <DataGrid ItemsSource="{Binding Modsets}" SelectedItem="{Binding SelectedModset}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="210">
                                <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Spiel" Binding="{Binding Game}" Width="90"/><DataGridTextColumn Header="Mod-Ordner" Binding="{Binding ModFolderDisplayPath}" Width="*"/><DataGridTextColumn Header="Letzter Start" Binding="{Binding LastStartedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/><DataGridCheckBoxColumn Header="Verwaltet" Binding="{Binding IsManagedDirectory}" Width="80"/></DataGrid.Columns>
                            </DataGrid>

                            <Border Margin="0,16,0,0" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedModsetName}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedModsetGameText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Aktualisieren" Command="{Binding RefreshSelectedInspectionCommand}"/></Grid>
                                    <Grid Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#101720" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="Mods" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{Binding SelectedModCountText}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="#101720" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="Profile" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{Binding SelectedProfileCountText}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border></Grid>
                                    <TextBlock Text="{Binding SelectedInspectionStatus}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Mod-Ordner" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedModDirectory}" TextWrapping="Wrap"/></Grid>
                                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Lokale Profile" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedLocalProfilesDirectory}" TextWrapping="Wrap"/></Grid>
                                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Steam-Profile" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedSteamProfilesDirectory}" TextWrapping="Wrap"/></Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Mod-Ordner öffnen" Command="{Binding OpenModDirectoryCommand}" Margin="0,0,7,0"/><Button Content="Lokale Profile öffnen" Command="{Binding OpenLocalProfilesDirectoryCommand}" Margin="0,0,7,0"/><Button Content="Steam-Profile öffnen" Command="{Binding OpenSteamProfilesDirectoryCommand}"/></StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,14,0,0" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Lokale Mods" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="Inhalte des ausgewählten Mod-Ordners – read-only, ähnlich zur Workshop-Liste." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding LocalModItemCountText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Suche" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding LocalModSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="Sortierung" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding LocalModSortModes}" SelectedItem="{Binding LocalModSortMode}" Height="34" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Typ" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding LocalModTypeFilters}" SelectedItem="{Binding LocalModTypeFilter}" Height="34" />
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding LocalModVisibleItems}"
                                              SelectedItem="{Binding SelectedLocalMod}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              MinHeight="260"
                                              MaxHeight="420">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mod-Name / Datei" Binding="{Binding Name}" Width="260" />
                                            <DataGridTextColumn Header="Typ" Binding="{Binding TypeText}" Width="85" />
                                            <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="105" />
                                            <DataGridTextColumn Header="Zuletzt geändert" Binding="{Binding LastWriteTimeUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" />
                                            <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Im Explorer öffnen" Command="{Binding OpenSelectedLocalModCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,30,38,28">
                            <TextBlock Text="Steam Workshop" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="Lokal installierte ETS2-/ATS-Workshop-Inhalte mit Steam-Titeln durchsuchen und verwalten. Steam-Abonnements werden vom Launcher nicht verändert." Margin="0,7,0,22" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" TextWrapping="Wrap" />

                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Spiel" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding WorkshopGames}" SelectedItem="{Binding WorkshopSelectedGame}" Height="34" Padding="8,5" />
                                    <TextBlock Grid.Column="2" Text="{Binding WorkshopItemCountText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="18,0,0,0" />
                                    <Button Grid.Column="3" Content="Aktualisieren" Command="{Binding RefreshWorkshopCommand}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,12,0,12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Suche" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding WorkshopSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="9,7" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Sortierung" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding WorkshopSortModes}" SelectedItem="{Binding WorkshopSortMode}" Height="34" Padding="8,5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Titel-Filter" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding WorkshopTitleFilters}" SelectedItem="{Binding WorkshopTitleFilter}" Height="34" Padding="8,5" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,0,0,12" Padding="14" Background="#101720" BorderBrush="#263342" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding WorkshopStatusText}" TextWrapping="Wrap" />
                                    <TextBlock Text="Gefundene Workshop-Pfade" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,10,0,3" />
                                    <TextBlock Text="{Binding WorkshopRootsText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <DataGrid ItemsSource="{Binding WorkshopVisibleItems}" SelectedItem="{Binding SelectedWorkshopItem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="330">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mod-Name" Binding="{Binding DisplayName}" Width="260" />
                                    <DataGridTextColumn Header="PublishedFileId" Binding="{Binding PublishedFileId}" Width="135" />
                                    <DataGridTextColumn Header="Spiel" Binding="{Binding Game}" Width="80" />
                                    <DataGridTextColumn Header="Zuletzt geändert" Binding="{Binding DisplayLastUpdatedUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" />
                                    <DataGridTextColumn Header="Lokaler Workshop-Ordner" Binding="{Binding ContentPath}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Lokalen Ordner öffnen" Command="{Binding OpenSelectedWorkshopFolderCommand}" Margin="0,0,8,0" />
                                <Button Content="Steam-Workshop-Seite öffnen" Command="{Binding OpenSelectedWorkshopPageCommand}" />
                            </StackPanel>

                            <Border Margin="0,18,0,0" Background="#111A24" BorderBrush="#263342" BorderThickness="1" CornerRadius="10" Padding="14">
                                <TextBlock Text="Workshop-Titel werden beim Aktualisieren read-only über die öffentliche Steam-Detailabfrage ergänzt. Wenn Steam nicht erreichbar ist oder ein Eintrag keinen Titel liefert, bleibt die PublishedFileId als Fallback sichtbar. Subscribe/Unsubscribe und andere SteamUGC-Schreibaktionen bleiben deaktiviert." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,30,38,28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Save-Editor" FontSize="30" FontWeight="Bold" />
                                    <TextBlock Text="Profile, Saves sowie Truck- und Trailerwerte sicher bearbeiten." Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Profile laden" Command="{Binding RefreshSaveEditorCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,9" VerticalAlignment="Center" />
                            </Grid>

                            <Border Margin="0,22,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Spiel" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding SaveEditorGames}" SelectedItem="{Binding SaveEditorSelectedGame}" Height="34" Padding="8,5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Profil" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding SaveEditorProfiles}" SelectedItem="{Binding SaveEditorSelectedProfile}" DisplayMemberPath="DisplayName" Height="34" Padding="8,5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Save" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding SaveEditorSaves}" SelectedItem="{Binding SaveEditorSelectedSave}" DisplayMemberPath="DisplayName" Height="34" Padding="8,5" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding SaveEditorGameHome}" Margin="2,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Profil &amp; Karriere" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="Änderungen werden erst nach Bestätigung angewendet." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,14" />
                                            <TextBlock Text="Profilname" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SaveEditorProfileNameText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                                <Button Grid.Column="1" Content="Umbenennen" Command="{Binding RenameSaveEditorProfileCommand}" Margin="8,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="Geld" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SaveEditorMoneyText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                                <Button Grid.Column="1" Content="Setzen" Command="{Binding SetSaveEditorMoneyCommand}" Margin="8,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="Erfahrungspunkte (XP)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SaveEditorExperienceText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                                <Button Grid.Column="1" Content="Setzen" Command="{Binding SetSaveEditorExperienceCommand}" Margin="8,0,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,16,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Karriere-Skills" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="ADR als Maske 0–63, alle anderen Skills 0–6." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,12" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="ADR-Maske" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding SaveEditorAdrMaskText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6" />
                                                    <TextBlock Text="Fernfahrten" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding SaveEditorLongDistanceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6" />
                                                    <TextBlock Text="Hochwertige Fracht" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding SaveEditorHighValueCargoText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="8,6" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Zerbrechliche Fracht" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding SaveEditorFragileCargoText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6" />
                                                    <TextBlock Text="Eilaufträge" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding SaveEditorUrgentDeliveryText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6" />
                                                    <TextBlock Text="Eco-Driving" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding SaveEditorEcoDrivingText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="8,6" />
                                                </StackPanel>
                                            </Grid>
                                            <Button Content="Skills übernehmen" Command="{Binding SetSaveEditorCareerSkillsCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,16,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Aktiver Truck" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SaveEditorActiveTruckText}" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />

                                            <TextBlock Text="Eigener Truck auswählen" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding SaveEditorTrucks}" SelectedItem="{Binding SaveEditorSelectedTruck}" DisplayMemberPath="Id" Height="34" Padding="8,5" />
                                                <Button Grid.Column="1" Content="Wechseln" Command="{Binding SwitchSaveEditorTruckCommand}" Margin="8,0,0,0" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <Button Content="Truck reparieren" Command="{Binding RepairSaveEditorTruckCommand}" />
                                            </StackPanel>

                                            <TextBlock Text="Kraftstoff (0–1)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SaveEditorFuelText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                                <Button Grid.Column="1" Content="Setzen" Command="{Binding SetSaveEditorFuelCommand}" Margin="8,0,0,0" />
                                            </Grid>

                                            <TextBlock Text="Kilometerstand" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SaveEditorMileageText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                                <Button Grid.Column="1" Content="Setzen" Command="{Binding SetSaveEditorMileageCommand}" Margin="8,0,0,0" />
                                            </Grid>

                                            <TextBlock Text="Motor · im aktuellen Save für dieses Truck-Modell beobachtet" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding SaveEditorEngines}" SelectedItem="{Binding SaveEditorSelectedEngine}" DisplayMemberPath="DataPath" Height="34" Padding="8,5" />
                                                <Button Grid.Column="1" Content="Motor setzen" Command="{Binding SetSaveEditorEngineCommand}" Margin="8,0,0,0" />
                                            </Grid>

                                            <TextBlock Text="Getriebe · im aktuellen Save für dieses Truck-Modell beobachtet" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding SaveEditorTransmissions}" SelectedItem="{Binding SaveEditorSelectedTransmission}" DisplayMemberPath="DataPath" Height="34" Padding="8,5" />
                                                <Button Grid.Column="1" Content="Getriebe setzen" Command="{Binding SetSaveEditorTransmissionCommand}" Margin="8,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="Die Auswahl stammt nur aus bereits vorhandenen Trucks desselben Modells im aktuellen Save. Dadurch werden keine unbekannten Definitionen geraten." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Aktiver Trailer" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SaveEditorActiveTrailerText}" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />

                                            <TextBlock Text="Eigener Trailer auswählen" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding SaveEditorTrailers}" SelectedItem="{Binding SaveEditorSelectedTrailer}" DisplayMemberPath="Id" Height="34" Padding="8,5" />
                                                <Button Grid.Column="1" Content="Wechseln" Command="{Binding SwitchSaveEditorTrailerCommand}" Margin="8,0,0,0" />
                                            </Grid>

                                            <Button Content="Trailer reparieren" Command="{Binding RepairSaveEditorTrailerCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />

                                            <TextBlock Text="Frachtgewicht (cargo_mass)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SaveEditorCargoMassText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                                <Button Grid.Column="1" Content="Setzen" Command="{Binding SetSaveEditorCargoMassCommand}" Margin="8,0,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,16,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Kennzeichen" FontSize="18" FontWeight="SemiBold" />
                                            <Grid Margin="0,12,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Ländercode" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding SaveEditorPlateCountry, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="8,6" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Hintergrund / Text RGB" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding SaveEditorPlateBackgroundRgb, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                                        <TextBox Grid.Column="2" Text="{Binding SaveEditorPlateTextRgb, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="Truck-Kennzeichen" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SaveEditorTruckPlateText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                                <Button Grid.Column="1" Content="Truck setzen" Command="{Binding SetSaveEditorTruckPlateCommand}" Margin="8,0,0,0" />
                                            </Grid>

                                            <TextBlock Text="Trailer-Kennzeichen" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SaveEditorTrailerPlateText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                                <Button Grid.Column="1" Content="Trailer setzen" Command="{Binding SetSaveEditorTrailerPlateCommand}" Margin="8,0,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,16,0,0" Background="#101720" BorderBrush="#263342" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Sicherheits-Backup" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SaveEditorLastBackupPath}" Margin="0,6,0,10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" />
                                            <Button Content="Letztes Backup wiederherstellen" Command="{Binding RestoreSaveEditorLastBackupCommand}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,18,0,0" Background="#111A24" BorderBrush="#263342" BorderThickness="1" CornerRadius="10" Padding="14">
                                <TextBlock Text="{Binding SaveEditorStatusText}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,30,38,28" MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Einstellungen" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="Launcher-Verhalten und Standardpfade konfigurieren." Margin="0,7,0,24" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Standardordner für neue Mod-Ordner" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Dieser Pfad ist der Standardordner für neu angelegte Mod-Ordner. Beim Modset selbst wird der ausgewählte Ordner direkt verwendet." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,10" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SettingsDefaultModsetRoot, UpdateSourceTrigger=PropertyChanged}" Padding="9,7"/><Button Grid.Column="1" Content="Durchsuchen …" Command="{Binding BrowseDefaultModsetRootCommand}" Margin="8,0,0,0"/></Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Verhalten" FontSize="17" FontWeight="SemiBold" />
                                    <CheckBox Content="Startprüfung vor dem Spielstart anzeigen" IsChecked="{Binding SettingsShowStartCheck}" Margin="0,14,0,0" />
                                    <CheckBox Content="Anzahl der Mods anzeigen" IsChecked="{Binding SettingsShowModCount}" Margin="0,10,0,0" />
                                    <CheckBox Content="Letztes ausgewähltes Modset merken" IsChecked="{Binding SettingsRememberLastModset}" Margin="0,10,0,0" />
                                    <TextBlock Text="Kritische Startfehler bleiben auch bei deaktivierter Startprüfung gesperrt." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,14,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="LicenseHub-Lizenz" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Deaktiviert die Geräteaktivierung dieses PCs serverseitig bei LicenseHub. Der lokal gespeicherte Lizenz-Key wird nur entfernt, wenn LicenseHub die Deaktivierung erfolgreich bestätigt hat." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,12" TextWrapping="Wrap" />
                                    <Button Content="Lizenz auf diesem PC deaktivieren" Command="{Binding DeactivateLicenseCommand}" Padding="18,9" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Button Content="Einstellungen speichern" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="18,9" HorizontalAlignment="Left" Margin="0,16,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,30,38,28" MaxWidth="850" HorizontalAlignment="Left">
                            <Image Source="/NmcScsLauncher.App;component/Assets/nmc-scs-launcher-logo.png" Width="340" Height="113" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10" />
                            <TextBlock Text="NMC SCS LAUNCHER" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="Moderner Windows-Launcher für getrennte ETS2- und ATS-Modsets." Margin="0,7,0,24" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="{Binding VersionText}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="NMC IT-SERVICE" Margin="0,5,0,18" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="Der Launcher verwendet pro Modset direkt den ausgewählten Mod-Ordner. Lokale und Steam-Profile bleiben in den normalen SCS-Dokumentenpfaden. Intern wird für den sicheren Spielstart ein verwaltetes -homedir verwendet; Profil- und Moddateien werden nicht verschoben." TextWrapping="Wrap" />
                                    <Border Margin="0,18,0,18" Height="1" Background="#263342" />
                                    <TextBlock Text="Euro Truck Simulator 2 und American Truck Simulator sind Marken von SCS Software. Steam ist eine Marke von Valve. NMC SCS LAUNCHER steht in keiner offiziellen Verbindung zu SCS Software oder Valve." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="1" Background="#0E151E" BorderBrush="#1F2B39" BorderThickness="0,1,0,0" Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Image Grid.Column="1" Source="/NmcScsLauncher.App;component/Assets/nmc-it-service-logo.png" Width="108" Height="36" Stretch="Uniform" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>