<Window x:Class="NmcScsLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMC SCS LAUNCHER"
        Width="1220" Height="780" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="24">
            <StackPanel>
                <TextBlock Text="NMC" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="SCS LAUNCHER" Margin="0,2,0,34" Foreground="{StaticResource SecondaryTextBrush}" />
                <Border Background="#17263A" CornerRadius="8" Padding="12" Margin="0,0,0,8"><TextBlock Text="⌂  Startseite" FontWeight="SemiBold" /></Border>
                <TextBlock Text="🚛  ETS2" Margin="12,12" /><TextBlock Text="🚚  ATS" Margin="12,12" />
                <TextBlock Text="▦  Modsets" Margin="12,12" /><TextBlock Text="👤  Profile" Margin="12,12" />
                <TextBlock Text="💾  Backup" Margin="12,12" /><TextBlock Text="⚙  Einstellungen" Margin="12,12" />
                <TextBlock Text="ⓘ  Info" Margin="12,12" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="42,34">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="NMC SCS LAUNCHER" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Steam-Erkennung und sichere, getrennte Modset-Verwaltung." Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,30,0,24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Spiele" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Border Padding="18" Background="{StaticResource CardBrush}" CornerRadius="12" Margin="0,0,0,9">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Euro Truck Simulator 2" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Ets2Status}" Margin="0,4,0,0" Foreground="#67D391"/><TextBlock Text="{Binding Ets2InstallPath}" Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Automatisch erkennen" Command="{Binding DetectEts2Command}" Padding="11,6" Margin="0,0,7,0"/><Button Content="Ordner auswählen" Command="{Binding BrowseEts2Command}" Padding="11,6"/></StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="18" Background="{StaticResource CardBrush}" CornerRadius="12" Margin="0,0,0,22">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="American Truck Simulator" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding AtsStatus}" Margin="0,4,0,0" Foreground="#67D391"/><TextBlock Text="{Binding AtsInstallPath}" Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Automatisch erkennen" Command="{Binding DetectAtsCommand}" Padding="11,6" Margin="0,0,7,0"/><Button Content="Ordner auswählen" Command="{Binding BrowseAtsCommand}" Padding="11,6"/></StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Modsets" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ModsetCountText}" Margin="12,4,0,0" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+ Neu" Command="{Binding CreateModsetCommand}" Padding="12,6" Margin="0,0,7,0"/>
                            <Button Content="Importieren" Command="{Binding ImportModsetCommand}" Padding="12,6" Margin="0,0,7,0"/>
                            <Button Content="Bearbeiten" Command="{Binding EditModsetCommand}" Padding="12,6" Margin="0,0,7,0"/>
                            <Button Content="Ordner öffnen" Command="{Binding OpenModsetHomeCommand}" Padding="12,6" Margin="0,0,7,0"/>
                            <Button Content="Entfernen" Command="{Binding RemoveModsetCommand}" Padding="12,6"/>
                        </StackPanel>
                    </Grid>
                    <Border Padding="12" Background="{StaticResource CardBrush}" CornerRadius="12">
                        <DataGrid ItemsSource="{Binding Modsets}" SelectedItem="{Binding SelectedModset}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="180" Background="#111821" Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="Spiel" Binding="{Binding Game}" Width="90" />
                                <DataGridTextColumn Header="Home-Verzeichnis" Binding="{Binding HomeBasePath}" Width="*" />
                                <DataGridCheckBoxColumn Header="Verwaltet" Binding="{Binding IsManagedDirectory}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Margin="0,18,0,0" Padding="16,10" Background="#1A2633" CornerRadius="8"><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/></Border>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2"><TextBlock Text="{Binding VersionText}" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="NMC Network" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}"/></DockPanel>
        </Grid>
    </Grid>
</Window>
