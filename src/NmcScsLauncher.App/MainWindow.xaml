<Window x:Class="NmcScsLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMC SCS LAUNCHER"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="24">
            <StackPanel>
                <TextBlock Text="NMC" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="SCS LAUNCHER" Margin="0,2,0,34" Foreground="{StaticResource SecondaryTextBrush}" />

                <Border Background="#17263A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <TextBlock Text="⌂  Startseite" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="🚛  ETS2" Margin="12,12" />
                <TextBlock Text="🚚  ATS" Margin="12,12" />
                <TextBlock Text="▦  Modsets" Margin="12,12" />
                <TextBlock Text="👤  Profile" Margin="12,12" />
                <TextBlock Text="💾  Backup" Margin="12,12" />
                <TextBlock Text="⚙  Einstellungen" Margin="12,12" />
                <TextBlock Text="ⓘ  Info" Margin="12,12" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="42,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="NMC SCS LAUNCHER" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Getrennte ETS2- und ATS-Modsets komfortabel verwalten und starten."
                           Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="15" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,32,0,24"
                    Padding="34"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="14">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="650">
                    <TextBlock Text="Phase 0 – Projektbasis"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Noch keine Modsets vorhanden. Die echte Steam- und Spielinstallationserkennung wird in Phase 1 ergänzt."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,14,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="15" />
                    <Border Margin="0,26,0,0" Padding="16,10" Background="#1A2633" CornerRadius="8">
                        <TextBlock Text="{Binding StatusText}" TextAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="2">
                <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Text="NMC Network" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
