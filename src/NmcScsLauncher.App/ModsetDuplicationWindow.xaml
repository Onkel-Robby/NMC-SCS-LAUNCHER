<Window x:Class="NmcScsLauncher.App.ModsetDuplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modset duplizieren"
        Width="620" Height="610"
        MinWidth="560" MinHeight="570"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Modset duplizieren" FontSize="26" FontWeight="Bold" />
            <TextBlock x:Name="SourceTextBlock" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Name der Kopie" FontWeight="SemiBold" />
            <TextBox x:Name="NameTextBox" Margin="0,7,0,0" Padding="10,7" TextChanged="NameTextBox_OnTextChanged" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="TargetPathLabel" Text="Neues Home-Verzeichnis" FontWeight="SemiBold" />
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TargetPathTextBox" Padding="10,7" />
                <Button Grid.Column="1" Content="Übergeordneten Ordner wählen" Margin="9,0,0,0" Padding="12,7" Click="BrowseTarget_OnClick" />
            </Grid>
            <TextBlock x:Name="TargetPathHint" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"
                       Text="Der Zielordner muss neu sein. Die Kopie erhält ein vollständig eigenes Home-Verzeichnis." />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,22,0,0">
            <TextBlock Text="Inhalte kopieren" FontWeight="SemiBold" FontSize="15" />
            <WrapPanel Margin="0,9,0,0">
                <CheckBox x:Name="ConfigurationCheckBox" Content="Konfiguration" IsChecked="True" Margin="0,0,22,9" />
                <CheckBox x:Name="ModsCheckBox" Content="Mods" IsChecked="True" Margin="0,0,22,9" />
                <CheckBox x:Name="ProfilesCheckBox" Content="Profile" IsChecked="True" Margin="0,0,22,9" />
                <CheckBox x:Name="ScreenshotsCheckBox" Content="Screenshots" IsChecked="True" Margin="0,0,22,9" />
                <CheckBox x:Name="LogsCheckBox" Content="Logs" IsChecked="False" Margin="0,0,22,9" />
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="4" Margin="0,15,0,0" Background="#111A24" BorderBrush="#263342" BorderThickness="1" CornerRadius="9" Padding="13">
            <TextBlock x:Name="CopyInfoTextBlock" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                       Text="Launcher-Metadaten wie Beschreibung, Profilvorgabe und zusätzliche Startparameter werden immer übernommen. Die ausgewählten Inhalte werden als echte, unabhängige Dateien kopiert. Links/Junctions werden nicht verfolgt." />
        </Border>

        <TextBlock x:Name="ValidationTextBlock" Grid.Row="5" Margin="0,16,0,0" Foreground="#FFB4A9" TextWrapping="Wrap" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Abbrechen" Width="105" Margin="0,0,9,0" IsCancel="True" />
            <Button Content="Duplizieren" Width="120" Style="{StaticResource PrimaryButtonStyle}" Click="Duplicate_OnClick" />
        </StackPanel>
    </Grid>
</Window>
