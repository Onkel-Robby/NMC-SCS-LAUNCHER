<Window x:Class="NmcScsLauncher.App.ApplicationUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMC SCS LAUNCHER – Update"
        Width="660" Height="585" MinWidth="600" MinHeight="525"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Icon="/NmcScsLauncher.App;component/Assets/nmc-scs-launcher.ico">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="/NmcScsLauncher.App;component/Assets/nmc-scs-launcher-logo.png" Width="185" Height="62" Stretch="Uniform" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="LicenseHub Update" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Eine neue Version des NMC SCS LAUNCHER ist verfügbar."
                           Margin="0,6,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,22,0,16"
                Padding="18"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Installiert" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="CurrentVersionTextBlock" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Verfügbar" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="LatestVersionTextBlock" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="16"
                Background="#101720"
                BorderBrush="#263342"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="MandatoryTextBlock"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}"
                               Visibility="Collapsed"
                               Text="Dieses Update wurde von LicenseHub als verpflichtend markiert." />
                    <TextBlock Text="Änderungen" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <TextBlock x:Name="ChangelogTextBlock"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ReleaseDateTextBlock"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed" />
            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LaterButton"
                    Content="Später"
                    Click="Later_OnClick"
                    HorizontalAlignment="Left"
                    Padding="18,9" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DownloadButton"
                        Content="Herunterladen &amp; prüfen"
                        Click="Download_OnClick"
                        Padding="18,9"
                        Margin="0,0,10,0" />
                <Button x:Name="InstallButton"
                        Content="Installieren &amp; neu starten"
                        Click="Install_OnClick"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="18,9"
                        IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="5" Margin="0,16,0,0" Padding="0,10,0,0" BorderBrush="#1F2B39" BorderThickness="0,1,0,0">
            <Image Source="/NmcScsLauncher.App;component/Assets/nmc-it-service-logo.png" Width="120" Height="40" Stretch="Uniform" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
