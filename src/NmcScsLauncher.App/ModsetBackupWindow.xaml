<Window x:Class="NmcScsLauncher.App.ModsetBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modset sichern"
        Width="540" Height="420"
        MinWidth="500" MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Backup erstellen" FontSize="26" FontWeight="Bold" />
            <TextBlock x:Name="SourceTextBlock" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Inhalte sichern" FontWeight="SemiBold" FontSize="15" />
            <CheckBox x:Name="ConfigurationCheckBox" Content="Konfiguration (.cfg / .sii / .ini)" IsChecked="True" Margin="0,12,0,0" />
            <CheckBox x:Name="ProfilesCheckBox" Content="Profile (lokal und Steam)" IsChecked="True" Margin="0,10,0,0" />
            <CheckBox x:Name="ModsCheckBox" Content="Mods mit sichern" IsChecked="False" Margin="0,10,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,20,0,0" Background="#111A24" BorderBrush="#263342" BorderThickness="1" CornerRadius="9" Padding="13">
            <TextBlock x:Name="BackupInfoTextBlock" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                       Text="Mods sind standardmäßig deaktiviert, da große Map-/Modsets sehr umfangreich sein können. Das Backup wird als ZIP mit NMC-Manifest gespeichert. Quelldateien werden nicht verändert." />
        </Border>

        <TextBlock x:Name="ValidationTextBlock" Grid.Row="3" Margin="0,16,0,0" Foreground="#FFB4A9" TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Abbrechen" Width="105" Margin="0,0,9,0" IsCancel="True" />
            <Button Content="Weiter …" Width="120" Style="{StaticResource PrimaryButtonStyle}" Click="Continue_OnClick" />
        </StackPanel>
    </Grid>
</Window>
