<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\branding\nmc-scs-launcher.ico</ApplicationIcon>
    <AssemblyName>NmcScsLauncher.Installer.UI</AssemblyName>
    <RootNamespace>NmcScsLauncher.Installer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\branding\nmc-scs-launcher.ico" Link="Assets\nmc-scs-launcher.ico" />
    <Resource Include="..\..\branding\nmc-scs-launcher-logo.png" Link="Assets\nmc-scs-launcher-logo.png" />
    <Resource Include="..\..\branding\nmc-it-service-logo.png" Link="Assets\nmc-it-service-logo.png" />
  </ItemGroup>
</Project>
