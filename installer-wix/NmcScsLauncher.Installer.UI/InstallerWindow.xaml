<Window x:Class="NmcScsLauncher.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NMC SCS LAUNCHER Setup"
        Width="820"
        Height="560"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0A1018"
        Foreground="#F4F7FB"
        Icon="Assets/nmc-scs-launcher.ico"
        ResizeMode="CanMinimize"
        Closing="Window_OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#101923" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#131F2B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#26384B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9BAABC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#21C7E8" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4DD8F0" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#172433" />
            <Setter Property="BorderBrush" Value="#31485F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#213248" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0E1721" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F8EB8" />
            <Setter Property="BorderBrush" Value="#21C7E8" />
            <Setter Property="Padding" Value="22,10" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C141E" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="CaretBrush" Value="#F4F7FB" />
            <Setter Property="BorderBrush" Value="#31485F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDE6EF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Image Source="Assets/nmc-scs-launcher-logo.png"
                       Width="310"
                       Height="102"
                       Stretch="Uniform"
                       HorizontalAlignment="Left" />
                <TextBlock x:Name="VersionText"
                           Margin="4,-3,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="#0E1823"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15,10"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="NMC INSTALLER" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="InstalledStateText"
                               Text="Installation wird geprüft …"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText"
                           Grid.Row="0"
                           Text="NMC SCS LAUNCHER installieren"
                           FontSize="23"
                           FontWeight="Bold" />

                <TextBlock x:Name="StatusText"
                           Grid.Row="2"
                           Text="Installer wird vorbereitet."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathTextBox" MinWidth="420" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="2"
                            Content="Durchsuchen"
                            Click="BrowseButton_OnClick" />
                </Grid>

                <StackPanel Grid.Row="6" Orientation="Horizontal">
                    <CheckBox x:Name="DesktopShortcutCheckBox"
                              Content="Desktop-Verknüpfung erstellen"
                              IsChecked="False" />
                </StackPanel>

                <Grid Grid.Row="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="ProgressBar"
                                 Height="12"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#08111A" />
                    <TextBlock x:Name="ProgressText"
                               Grid.Row="2"
                               Text="Bereit"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11" />
                </Grid>

                <Border x:Name="ResultPanel"
                        Grid.Row="9"
                        Margin="0,18,0,0"
                        Padding="14"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="ResultTitleText"
                                   FontWeight="Bold"
                                   FontSize="15" />
                        <TextBlock x:Name="ResultBodyText"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                        <CheckBox x:Name="LaunchAfterFinishCheckBox"
                                  Margin="0,12,0,0"
                                  Content="NMC SCS LAUNCHER starten"
                                  IsChecked="True"
                                  Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="10" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="UninstallButton"
                            Content="Deinstallieren"
                            Visibility="Collapsed"
                            Click="UninstallButton_OnClick" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton"
                                Content="Abbrechen"
                                Margin="0,0,10,0"
                                Click="CancelButton_OnClick" />
                        <Button x:Name="PrimaryButton"
                                Content="Installieren"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="PrimaryButton_OnClick" />
                        <Button x:Name="FinishButton"
                                Content="Fertig"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="FinishButton_OnClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Installer-Engine: WiX Toolset 5 / Burn"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       VerticalAlignment="Center" />
            <Image Grid.Column="1"
                   Source="Assets/nmc-it-service-logo.png"
                   Width="125"
                   Height="42"
                   Stretch="Uniform"
                   HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
